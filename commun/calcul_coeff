# -*- coding: utf-8 -*-
"""
metaheuristiques/calibrer_poids_internes.py — Calibrage des POINTS DE PÉNALITÉ de Pbloc, Plits et Pambu
=========================================================================================================

    Pbloc = w_np x non placés + w_dep x dépassement (min) + w_ino x bloc inoccupé (min) + report
    Plits = w_lit x lits-jours en trop + w_vl x variance des lits
    Pambu = w_pl x places-jours en trop + w_vp x variance des places
    valeurs actuelles (PoidsNiveau2) : 8000, 100, 1, 5000, 20, 5000, 20

Même méthode que calibrer_coefficients.py (dont ce script réutilise les fonctions) :
  * chaque jeu de poids est optimisé par le Tabou du projet sur l'instance d'étude et le planning v28
    (capacités réduites, report sur 3 semaines) ;
  * le programme obtenu est jugé sur les indicateurs BRUTS, par ordre de priorité : lits en trop > places en
    trop > patients non opérés dans la semaine > dépassement > irrégularité (seuil = 2 x bruit entre graines) ;
  * recherche ALÉATOIRE log-uniforme : chaque poids est multiplié par un facteur entre 1/10 et 10
    (les grilles complètes sur 7 poids seraient trop longues) ; la formule actuelle est toujours testée ;
  * étape 2 : les K meilleurs jeux + l'actuel sont rejoués avec plus de graines, le choix se fait entre eux.

Sorties (resultats_poids/) : poids_optimaux.json, sensibilite_poids.png, comparaison_poids.png, essais.csv

    python metaheuristiques/calibrer_poids_internes.py                    # ≈ 9 min (budget 540 s)
    python metaheuristiques/calibrer_poids_internes.py --budget 120 --tirages 20
"""
from __future__ import annotations

import argparse
import csv
import json
import math
import multiprocessing as mp
import os
import random
import statistics
import time
from pathlib import Path

import calibrer_coefficients as C
import hybridage2 as H
from sorties import SuiviExecution
from structures_communes import POIDS_N2, PoidsNiveau2

NOMS = ["non_place", "depassement_vac", "bloc_inoccupe", "lit", "var_lits", "place", "var_places"]
LIBELLES = {"non_place": "non placé", "depassement_vac": "dépassement / min", "bloc_inoccupe": "inoccupé / min",
            "lit": "lit-jour en trop", "var_lits": "variance lits", "place": "place-jour en trop",
            "var_places": "variance places"}
DEFAUT = tuple(getattr(POIDS_N2, n) for n in NOMS)


class EtatPoids(H.EtatAvecReport):
    """État incrémental commun dont les points de pénalité sont ceux du jeu testé."""

    def __init__(self, instance2, affectations, poids: PoidsNiveau2):
        super().__init__(instance2, affectations)
        self.poids = poids                         # lu par score_blocs / score_lits / score_places


class ProblemePoids(H.ProblemeHybrideN2):
    def __init__(self, instance2, journal, poids):
        super().__init__(instance2, journal)
        self.poids = poids

    def etat(self, individu):
        return EtatPoids(self.inst, dict(zip(self.pids, individu)), self.poids)


_INST: dict = {}


def _essai(args) -> dict:
    nom, lits, places, facteurs, graine, duree = args
    if (nom, lits, places) not in _INST:
        _INST[(nom, lits, places)] = C.construire_instance(nom, lits, places)
    inst = _INST[(nom, lits, places)]
    poids = PoidsNiveau2(**{n: d * f for n, d, f in zip(NOMS, DEFAUT, facteurs)})
    pb = ProblemePoids(inst, H.Journal(SuiviExecution(pas_enregistrement=10 ** 9)), poids)
    rng = random.Random(graine)
    depart = pb.depuis_solution(pb.solution_initiale(rng))
    ind, _ = H.RechercheLocaleMixte(2, pb, H.ParametresRechercheLocale()).tabou(depart, rng, duree=duree)
    return {"instance": nom, "graine": graine, **{f"f_{n}": f for n, f in zip(NOMS, facteurs)},
            **C.indicateurs(inst, dict(zip(pb.pids, ind)))}


def _cle(e) -> tuple:
    return tuple(float(e[f"f_{n}"]) for n in NOMS)


def moyennes(essais, instances) -> dict:
    par = {}
    for e in essais:
        if e["instance"] in instances:
            par.setdefault(_cle(e), {}).setdefault(e["instance"], []).append(e)
    return {c: {k: sum(statistics.fmean(float(x[k]) for x in lst) for lst in d.values())
                for k, _, _ in C.CRITERES} for c, d in par.items()}


def bruit_et_seuils(essais, instances):
    par = {}
    for e in essais:
        if e["instance"] in instances:
            par.setdefault(_cle(e), {}).setdefault(e["instance"], []).append(e)
    C.SEUILS.clear()
    for k, _, s in C.CRITERES:
        v = [math.sqrt(sum(statistics.variance([float(x[k]) for x in l]) for l in d.values() if len(l) > 1))
             for d in par.values() if any(len(l) > 1 for l in d.values())]
        C.SEUILS[k] = max(s, 2 * statistics.median(v)) if v else s


def main():
    ap = argparse.ArgumentParser(description="Calibrage des points de pénalité de Pbloc, Plits, Pambu")
    ap.add_argument("--budget", type=float, default=540, help="secondes de calcul au total")
    ap.add_argument("--tirages", type=int, default=40, help="jeux de poids tirés au hasard (étape 1)")
    ap.add_argument("--graines", type=int, default=1, help="graines par jeu à l'étape 1")
    ap.add_argument("--confirmation", type=int, nargs=2, default=[4, 4], metavar=("K", "S"))
    ap.add_argument("--etendue", type=float, default=10.0, help="facteurs tirés entre 1/E et E")
    ap.add_argument("--lits", type=int, nargs=2, default=[10, 19])
    ap.add_argument("--places", type=int, nargs=2, default=[6, 6])
    ap.add_argument("--coeurs", type=int, default=os.cpu_count() or 1)
    ap.add_argument("--sortie", default="resultats_poids")
    o = ap.parse_args()
    sortie = Path(o.sortie)
    sortie.mkdir(parents=True, exist_ok=True)
    instances = ["etude", "v28"]
    caps = {"etude": (o.lits[0], o.places[0]), "v28": (o.lits[1], o.places[1])}
    rng = random.Random(7)
    jeux = [tuple(1.0 for _ in NOMS)] + [tuple(round(math.exp(rng.uniform(-1, 1) * math.log(o.etendue)), 3)
                                             for _ in NOMS) for _ in range(o.tirages)]
    k, s = o.confirmation
    n1, n2 = len(jeux) * 2 * o.graines, (k + 1) * 2 * s
    coeurs = max(1, o.coeurs)
    duree = max(0.5, 0.8 * o.budget * coeurs / (n1 + n2))
    print(f"Étape 1 : {len(jeux)} jeux de poids x 2 instances x {o.graines} graine(s) ; étape 2 : {k} meilleurs + actuel "
          f"x {s} graines. Tabou de {duree:.1f} s, {coeurs} cœur(s), ≈ {(n1 + n2) * duree / coeurs / 0.8 / 60:.1f} min")
    t0 = time.perf_counter()
    taches = [(i, *caps[i], j, 1000 + g, duree) for i in instances for j in jeux for g in range(o.graines)]
    with mp.Pool(coeurs) as pool:
        essais = list(pool.imap_unordered(_essai, taches))
        bruit_et_seuils(essais, instances)
        ordre = C.classer(moyennes(essais, instances))
        cand = list(dict.fromkeys(ordre[:k] + [jeux[0]]))
        print(f"  étape 1 terminée ({time.perf_counter() - t0:.0f} s) ; confirmation de {len(cand)} jeux")
        taches = [(i, *caps[i], j, 1000 + g, duree) for i in instances for j in cand
                  for g in range(o.graines, o.graines + s)]
        essais += list(pool.imap_unordered(_essai, taches))
    with (sortie / "essais.csv").open("w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=list(essais[0]), delimiter=";")
        w.writeheader()
        w.writerows(essais)

    conf = [e for e in essais if _cle(e) in cand]
    bruit_et_seuils(conf, instances)
    moy_c = moyennes(conf, instances)
    choix = C.classer(moy_c)[0]
    poids = {n: round(d * f, 3) for n, d, f in zip(NOMS, DEFAUT, choix)}
    m, a = moy_c[choix], moy_c[jeux[0]]
    equivalent = all(m[c] >= a[c] - C.SEUILS[c] for c, _, _ in C.CRITERES[:3])
    res = {"poids_retenus": poids, "poids_actuels": dict(zip(NOMS, DEFAUT)), "facteurs": dict(zip(NOMS, choix)),
           "indicateurs_retenus": m, "indicateurs_actuels": a, "seuils": dict(C.SEUILS),
           "actuel_equivalent_au_retenu": equivalent, "temps_s": round(time.perf_counter() - t0)}
    (sortie / "poids_optimaux.json").write_text(json.dumps(res, ensure_ascii=False, indent=2), encoding="utf-8")

    # --- figures : sensibilité de chaque poids (étape 1) et comparaison actuel / retenu (étape 2)
    plt = C._plt()
    moy1 = moyennes(essais, instances)
    fig, axes = plt.subplots(1, len(NOMS), figsize=(3 * len(NOMS), 3.4), sharey=True)
    for ax, (idx, n) in zip(axes, enumerate(NOMS)):
        for c, v in moy1.items():
            ko = v["lits_trop"] + v["places_trop"] > 0.5
            ax.scatter(c[idx], v["non_operes"], s=22, color="#d62728" if ko else "#2a78d6",
                       marker="x" if ko else "o", lw=1.2)
        ax.axvline(1, color=C.ENCRE2, ls=":", lw=1)
        ax.axvline(choix[idx], color="#eda100", lw=2)
        ax.set_xscale("log")
        ax.grid(color=C.GRILLE, lw=0.8)
        C._style(ax, f"{LIBELLES[n]}\n(actuel {DEFAUT[idx]:g})", "facteur", "patients non opérés" if idx == 0 else "")
    fig.suptitle("Sensibilité de chaque point de pénalité — rond bleu : programme réalisable, croix rouge : lits ou places "
                 "en trop ; trait orange : valeur retenue", x=0.01, ha="left", fontsize=10, color=C.ENCRE)
    fig.tight_layout(rect=(0, 0, 1, 0.9))
    fig.savefig(sortie / "sensibilite_poids.png", dpi=150, facecolor="white")
    plt.close(fig)
    fig, axes = plt.subplots(1, 4, figsize=(14, 3))
    for ax, (cle, lib) in zip(axes, [("lits_trop", "lits-jours en trop"), ("places_trop", "places-jours en trop"),
                                     ("non_operes", "patients non opérés"), ("depassement_min", "dépassement (min)")]):
        vals = [a[cle], m[cle]]
        ax.barh([0, 1], vals, color=["#6b6a64", "#eda100"], height=0.6)
        for i, v in enumerate(vals):
            ax.text(v, i, f" {v:.1f}", va="center", fontsize=8)
        ax.set_yticks([0, 1], ["actuels", "retenus"] if ax is axes[0] else ["", ""])
        ax.invert_yaxis()
        ax.set_xlim(0, max(vals + [1]) * 1.3)
        C._style(ax, lib)
    fig.tight_layout()
    fig.savefig(sortie / "comparaison_poids.png", dpi=150, facecolor="white")
    plt.close(fig)

    print("\n  POIDS RETENUS : " + ", ".join(f"{n} = {v:g}" for n, v in poids.items()))
    print(f"  retenus : lits {m['lits_trop']:.1f} | places {m['places_trop']:.1f} | non opérés {m['non_operes']:.1f}")
    print(f"  actuels : lits {a['lits_trop']:.1f} | places {a['places_trop']:.1f} | non opérés {a['non_operes']:.1f}")
    print("  -> " + ("écart dans le bruit : les poids actuels sont validés" if equivalent
                     else "les poids retenus font mieux que les actuels au-delà du bruit"))
    print(f"  {sortie}/ ({time.perf_counter() - t0:.0f} s)")


if __name__ == "__main__":
    mp.freeze_support()
    main()